---
import { ui, indexProjects, apps, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const lang = Astro.props.lang as Lang;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const switchHref = lang === 'fr' ? `${base}en/` : base;

// Serializable app data for the lightbox script (paths resolved with base).
const appsData = apps.map((a) => ({
  name: a.name,
  tagline: a[lang].tagline,
  needsBorders: a.needsBorders,
  screens: a.screens.map((s) => ({ src: `${base}${s.src}`, alt: s.alt })),
}));

const cols = 15;
const rows = 7;
const dotSizes: string[] = [];
for (let row = 0; row < rows; row++) {
  for (let col = 0; col < cols; col++) {
    const size = (1.5 + (col / (cols - 1)) * 4.5).toFixed(2);
    dotSizes.push(size);
  }
}
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <title>{t.pageTitle}</title>
  <style set:html={`
    @font-face {
      font-family: 'NeueMontreal';
      src: url('${base}fonts/NeueMontreal-Regular.otf') format('opentype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'NeueMontreal';
      src: url('${base}fonts/NeueMontreal-Bold.otf') format('opentype');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
  `}></style>
  <style is:global>

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    body {
      font-family: 'NeueMontreal', Helvetica, Arial, system-ui, sans-serif;
      background: #fff;
      color: #111;
      overflow-x: hidden;
      overscroll-behavior: none;
    }

    /* ================================================================
       ANIMATIONS
    ================================================================ */

    @keyframes s1-slide-up {
      from { transform: translateY(110%); }
      to   { transform: translateY(0); }
    }

    @keyframes s1-image-in {
      from { transform: translateX(100%); }
      to   { transform: translateX(0); }
    }

    @keyframes s1-desc-in {
      from { opacity: 0; transform: translateY(0.5rem); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .s1__line-body, .s1__image, .s1__desc { animation: none; }
    }

    /* ================================================================
       LANG SWITCH
    ================================================================ */

    .lang-switch {
      position: fixed;
      top: clamp(1.5rem, 3vw, 2.5rem);
      right: clamp(2rem, 4vw, 4rem);
      z-index: 20;
      font-size: 0.65rem;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: #999;
      text-decoration: none;
      transition: color 0.15s;
    }

    .lang-switch:hover { color: #111; }

    body.contact-active .lang-switch { color: rgba(255,255,255,0.5); }
    body.contact-active .lang-switch:hover { color: #fff; }

    /* ================================================================
       SECTION 1
    ================================================================ */

    .s1 {
      min-height: 100dvh;
      padding: clamp(2rem, 4vw, 4rem);
      padding-bottom: 0;
      display: flex;
      flex-direction: column;
    }

    .s1__title {
      font-family: 'NeueMontreal', Helvetica, Arial, system-ui, sans-serif;
      font-weight: 400;
      font-size: clamp(5.5rem, 14vw, 16rem);
      line-height: 0.87;
      letter-spacing: -0.035em;
      color: #000000;
      margin-bottom: clamp(1rem, 3vh, 3.5rem);
      flex-shrink: 0;
    }

    .s1__line-clip {
      display: block;
      overflow: hidden;
      padding-bottom: 0.06em;
    }

    .s1__line-body {
      display: block;
      animation: s1-slide-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .s1__line-body--2 { animation-delay: 0.1s; }

    .s1__lower {
      flex: 1;
      position: relative;
      min-height: 70vh;
    }

    .s1__image-wrap {
      position: absolute;
      left: 0; right: 0;
      top: 28%;
      bottom: 0;
      overflow: hidden;
    }

    .s1__image {
      position: absolute;
      inset: 0;
      animation: s1-image-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
      overflow: hidden;
    }

    .s1__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      display: block;
    }

    .s1__desc {
      font-size: clamp(1rem, 2vw, 1.5rem);
      font-weight: 400;
      line-height: 1.65;
      color: #555;
      max-width: 44ch;
      margin-bottom: clamp(1rem, 2vh, 2rem);
      flex-shrink: 0;
      animation: s1-desc-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.9s both;
    }

    @media (min-width: 721px) {
      .s1__desc {
        align-self: flex-end;
        text-align: right;
        font-size: clamp(2rem, 4vw, 5rem);
        max-width: 20ch;
        line-height: 1.2;
      }
    }

    .s1-scroll-space {
      height: 100dvh;
      background: #fff;
      transition: background-color 0.5s ease;
    }

    body.contact-active .s1-scroll-space {
      background: transparent;
    }

    /* ================================================================
       PROJECTS OVERLAY
    ================================================================ */

    .proj-overlay {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 100dvh;
      z-index: 10;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: flex-end;
      padding: 0 0 calc(50dvh + clamp(1.5rem, 3vh, 3rem));
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0,0,0,0.1) 40%,
        rgba(0,0,0,0.35) 70%,
        rgba(0,0,0,0.55) 100%
      );
    }

    .proj-overlay.is-active {
      opacity: 1;
      pointer-events: all;
    }

    .proj-list {
      display: flex;
      gap: clamp(2rem, 4vw, 3.5rem);
      list-style: none;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-left: 50vw;
      padding-right: calc(50vw - 105px); /* last card centers at 50vw */
      width: 100%;
      padding-bottom: 2px;
      touch-action: pan-x;
    }

    .proj-list::-webkit-scrollbar { display: none; }

    .proj-card {
      flex-shrink: 0;
      width: 210px;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .proj-video {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      border-radius: 2px;
      margin-bottom: 0.6rem;
    }

    .proj-meta {
      font-size: 0.58rem;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.4);
    }

    .proj-title {
      font-size: clamp(1.1rem, 1.8vw, 1.5rem);
      font-weight: 400;
      color: #fff;
      line-height: 1;
      letter-spacing: -0.025em;
    }

    .proj-desc {
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.55;
    }

    .proj-links {
      display: flex;
      gap: 0.875rem;
      margin-top: 0.3rem;
    }

    .proj-link {
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255, 255, 255, 0.4);
      text-decoration: none;
      transition: color 0.15s;
    }

    .proj-link:hover { color: #fff; }

    /* ================================================================
       CONTACT MORPH
    ================================================================ */

    .s2__tagline {
      display: grid;
    }

    .s2__tagline-inner,
    .s2__contact-title {
      grid-area: 1 / 1;
    }

    .s2__tagline-inner {
      transition: opacity 0.45s ease, transform 0.45s ease;
    }

    .s2__contact-title {
      opacity: 0;
      transform: translateY(0.6rem);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
                  transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      letter-spacing: inherit;
      color: inherit;
    }

    body.contact-active .s2__tagline-inner {
      opacity: 0;
      transform: translateY(-0.4rem);
    }

    body.contact-active .s2__contact-title {
      position: fixed;
      top: clamp(2rem, 4vw, 4rem);
      left: clamp(2rem, 4vw, 4rem);
      color: #fff;
      opacity: 1;
      transform: translateY(0);
    }

    /* ================================================================
       CONTACT CTA
    ================================================================ */

    .contact-cta {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translateX(-50%) translateY(-50%);
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      opacity: 0;
      pointer-events: none;
    }

    .contact-cta__link {
      font-size: clamp(0.9rem, 1.5vw, 1.15rem);
      color: rgba(255, 255, 255, 0.75);
      text-decoration: none;
      letter-spacing: -0.01em;
      text-align: center;
      opacity: 0;
      transform: translateY(0.75rem);
      transition: color 0.15s;
    }

    .contact-cta__link:nth-child(1) {
      transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.38s,
                  transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.38s,
                  color 0.15s;
    }

    .contact-cta__link:nth-child(2) {
      transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.52s,
                  transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.52s,
                  color 0.15s;
    }

    .contact-cta.is-active {
      opacity: 1;
      pointer-events: all;
    }

    .contact-cta.is-active .contact-cta__link {
      opacity: 1;
      transform: translateY(0);
    }

    .contact-cta__link:hover { color: #fff; }

    /* ================================================================
       SECTION 2
    ================================================================ */

    .s2 {
      min-height: 100dvh;
      padding-block: clamp(2rem, 4vw, 5rem);
      padding-inline: 0;
      display: grid;
      grid-template-columns: 46% 1fr;
      align-content: start;
      position: relative;
      background: #fff;
      z-index: 1;
      transition: background-color 0.5s ease;
    }

    body.contact-active .s2 {
      background: transparent;
    }

    .s2__dots {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: repeat(15, 1fr);
      grid-template-rows: repeat(7, 1fr);
      align-items: center;
      justify-items: center;
      pointer-events: none;
      z-index: 0;
    }

    .s2__dots span {
      border-radius: 50%;
      background: #D62B2B;
    }

    .s2__tagline {
      grid-column: 1;
      grid-row: 1;
      padding-left: clamp(2rem, 4vw, 5rem);
      padding-right: 1rem;
      font-size: clamp(1.5rem, 3vw, 2.8rem);
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: #111;
      position: relative;
      z-index: 1;
    }

    .s2__body {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      margin-top: clamp(5rem, 18vh, 14rem);
      padding-right: clamp(2rem, 4vw, 5rem);
      position: relative;
      z-index: 1;
    }

    .s2__body-p {
      font-size: clamp(0.78rem, 1.05vw, 0.9rem);
      font-weight: 400;
      line-height: 1.75;
      color: #111;
      max-width: 38ch;
    }

    /* ================================================================
       RESPONSIVE
    ================================================================ */

    /* Mobile vertical project list (hidden on desktop) */
    .m-proj { display: none; }

    @media (max-width: 720px) {
      /* Hide all desktop-only elements */
      .s1-scroll-space, .proj-overlay, .s2, #contact-cta { display: none; }

      /* Hide lang switch on mobile (visible via m-proj__contact instead) */
      .lang-switch { display: none; }

      /* Hero: fixed full-screen image, white text */
      .s1__lower { flex: 0; min-height: 0; }
      .s1__image-wrap { position: fixed; inset: 0; z-index: 0; }
      .s1__image { animation: none; }
      .s1__title { font-size: clamp(2.5rem, 16vw, 5rem); color: #fff; position: relative; z-index: 1; }
      .s1__desc { color: rgba(255, 255, 255, 0.8); position: relative; z-index: 1; }

      /* Vertical project list */
      .m-proj {
        display: block;
        position: relative;
        background: transparent;
        z-index: 1;
      }

      .m-proj__list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .m-proj__item {
        padding: clamp(1.5rem, 5vw, 2.5rem) clamp(1.5rem, 5vw, 2.5rem) 0;
      }

      .m-proj__video {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
        border-radius: 2px;
        margin-bottom: 0.75rem;
      }

      .m-proj__meta {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-bottom: 0.3rem;
      }

      .m-proj__title {
        font-size: clamp(1.4rem, 6vw, 2rem);
        font-weight: 400;
        letter-spacing: -0.025em;
        color: #fff;
        line-height: 1;
        margin-bottom: 0.4rem;
      }

      .m-proj__desc {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.6);
        line-height: 1.55;
        margin-bottom: 0.5rem;
      }

      .m-proj__links {
        display: flex;
        gap: 1rem;
      }

      .m-proj__link {
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(255,255,255,0.45);
        text-decoration: none;
      }

      /* Fade-out + contact */
      .m-proj__fade {
        height: 6rem;
        pointer-events: none;
      }

      .m-proj__contact {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        padding: 4rem 1.5rem 6rem;
        text-align: center;
      }

      .m-proj__contact-link {
        font-size: clamp(0.85rem, 4vw, 1.1rem);
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        letter-spacing: -0.01em;
      }

      .m-proj__lang-switch {
        font-size: 0.6rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        text-decoration: none;
        margin-top: 0.5rem;
      }
    }
  </style>

  <!-- ================================================================
       MOBILE APPS SECTION + LIGHTBOX  (self-contained)
  ================================================================ -->
  <style is:global>
    @keyframes apps-rise {
      from { opacity: 0; transform: translateY(2rem); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Desktop apps band (between projects rail and contact) ── */
    .apps {
      position: relative;
      z-index: 3;
      background: #fff;
      min-height: 200dvh;
      padding: clamp(3rem, 7vh, 7rem) 0 clamp(3rem, 6vh, 6rem);
      display: flex;
      flex-direction: column;
    }

    .apps__caption {
      font-size: clamp(1.5rem, 3vw, 2.8rem);
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: #111;
      max-width: 24ch;
      padding: 0 clamp(2rem, 4vw, 4rem);
    }

    .apps__head {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: clamp(2rem, 5vh, 4rem);
      padding: 0 clamp(2rem, 4vw, 4rem);
    }

    .apps__kicker {
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #D62B2B;
    }

    .apps__title {
      font-size: clamp(2.5rem, 6vw, 5rem);
      font-weight: 400;
      letter-spacing: -0.03em;
      line-height: 0.9;
      color: #111;
    }

    .apps__hint {
      margin-left: auto;
      font-size: 0.7rem;
      letter-spacing: 0.04em;
      color: #999;
      align-self: flex-end;
    }

    .apps__row {
      display: flex;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
      justify-content: flex-start;
      flex: 0;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-top: 70dvh;
      padding: 1rem clamp(2rem, 4vw, 4rem) 2rem;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
    }
    .apps__row::-webkit-scrollbar { display: none; }

    .apps__row.is-visible {
      opacity: 1;
      transform: none;
    }

    .app {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.1rem;
      width: 230px;
    }

    /* ── Phone mockup ── */
    .phone {
      position: relative;
      isolation: isolate;
      width: 200px;
      aspect-ratio: 9 / 19.5;
      border-radius: 30px;
      padding: 7px;
      background: linear-gradient(150deg, #2a2a2a, #050505);
      box-shadow: 0 22px 50px -18px rgba(0,0,0,0.5), 0 2px 6px rgba(0,0,0,0.2);
      cursor: zoom-in;
      border: none;
      transition: transform 0.45s cubic-bezier(0.16,1,0.3,1), box-shadow 0.45s cubic-bezier(0.16,1,0.3,1);
      -webkit-tap-highlight-color: transparent;
    }

    .phone:hover,
    .phone:focus-visible {
      transform: translateY(-10px);
      box-shadow: 0 36px 70px -20px rgba(0,0,0,0.55), 0 3px 8px rgba(0,0,0,0.25);
      outline: none;
    }

    .phone:focus-visible { outline: 2px solid #D62B2B; outline-offset: 4px; }

    .phone__screen {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 23px;
      overflow: hidden;
    }

    .phone__screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: 23px;
    }

    /* Flat phones: screenshot already includes its own device frame, so drop
       our dark bezel/padding/shadow and show the whole mockup with an
       alpha-shaped shadow. */
    /* Frame rendered above the screenshot for needsBorders phones */
    .phone::after {
      content: '';
      position: absolute;
      inset: 7px;
      border-radius: 23px;
      box-shadow: 0 0 0 8px rgba(8,8,8,0.88);
      pointer-events: none;
      z-index: 2;
    }

    .phone--flat {
      background: none;
      padding: 0;
      box-shadow: none;
    }
    .phone--flat::after { display: none; }
    .phone--flat .phone__screen {
      border-radius: 0;
      overflow: visible;
    }
    .phone--flat .phone__screen img {
      object-fit: contain;
      filter: drop-shadow(0 18px 34px rgba(0,0,0,0.30));
    }
    .phone--flat:hover,
    .phone--flat:focus-visible {
      box-shadow: none;
    }

    /* dynamic island */
    /* .phone__island {
      position: absolute;
      top: 9px;
      left: 50%;
      transform: translateX(-50%);
      width: 58px;
      height: 17px;
      border-radius: 10px;
      background: #000;
      z-index: 2;
    } */

    .app__name {
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: -0.02em;
      color: #111;
      text-align: center;
    }

    .app__tagline {
      font-size: 0.72rem;
      line-height: 1.5;
      color: #777;
      text-align: center;
      max-width: 22ch;
      margin-top: -0.7rem;
    }

    /* ── Lightbox ── */
    .lb {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(8,8,8,0.82);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    .lb.is-open {
      opacity: 1;
      visibility: visible;
    }

    .lb__stage {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    .lb__phone {
      position: relative;
      isolation: isolate;
      width: min(78vw, 300px);
      aspect-ratio: 9 / 19.5;
      max-height: 76vh;
      border-radius: 42px;
      padding: 10px;
      background: linear-gradient(150deg, #2a2a2a, #050505);
      box-shadow: 0 40px 90px -20px rgba(0,0,0,0.7);
      transform-origin: top left;
    }

    .lb__screen {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 33px;
      overflow: hidden;
    }

    .lb__screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: 33px;
    }

    /* Frame rendered above the screenshot for needsBorders lightbox phones */
    .lb__phone::after {
      content: '';
      position: absolute;
      inset: 10px;
      border-radius: 33px;
      box-shadow: 0 0 0 11px rgba(8,8,8,0.88);
      pointer-events: none;
      z-index: 2;
    }

    .lb__phone--flat {
      background: none;
      padding: 0;
      box-shadow: none;
    }
    .lb__phone--flat::after { display: none; }
    .lb__phone--flat .lb__screen {
      border-radius: 0;
      overflow: visible;
    }
    .lb__phone--flat .lb__screen img {
      object-fit: contain;
      filter: drop-shadow(0 30px 60px rgba(0,0,0,0.55));
    }

    /* .lb__island {
      position: absolute;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      width: 84px;
      height: 24px;
      border-radius: 14px;
      background: #000;
      z-index: 2;
    } */

    .lb__caption {
      text-align: center;
      color: #fff;
      max-width: 32ch;
    }

    .lb__caption-name { font-size: 1.1rem; letter-spacing: -0.02em; }
    .lb__caption-tag  { font-size: 0.8rem; color: rgba(255,255,255,0.6); margin-top: 0.25rem; }

    .lb__dots {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 0.9rem;
    }

    .lb__dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: rgba(255,255,255,0.3);
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
    }
    .lb__dot.is-active { background: #fff; transform: scale(1.2); }

    .lb__btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 52px; height: 52px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.08);
      color: #fff;
      font-size: 1.3rem;
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: background 0.15s, border-color 0.15s;
    }
    .lb__btn:hover { background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.45); }
    .lb__btn--prev { left: clamp(0.75rem, 4vw, 3rem); }
    .lb__btn--next { right: clamp(0.75rem, 4vw, 3rem); }

    .lb__close {
      position: absolute;
      top: clamp(1rem, 3vw, 2rem);
      right: clamp(1rem, 3vw, 2rem);
      width: 44px; height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.08);
      color: #fff;
      font-size: 1.2rem;
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: background 0.15s;
    }
    .lb__close:hover { background: rgba(255,255,255,0.2); }

    @media (prefers-reduced-motion: reduce) {
      .phone, .lb { transition: opacity 0.2s ease, visibility 0.2s ease; }
      .lb__phone { transition: none !important; }
    }

    /* ── Mobile apps grid (inside the mobile flow) ── */
    .m-apps { display: none; }

    @media (max-width: 720px) {
      .apps { display: none; }

      .m-apps {
        display: block;
        /* No horizontal padding: the carousel runs edge-to-edge so phones can
           touch the screen borders while scrolling. The heading and the first
           phone keep their inset via their own padding below. */
        padding: clamp(2.5rem, 8vw, 4rem) 0 1rem;
        position: relative;
        z-index: 1;
      }

      .m-apps__head {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        margin-bottom: 1.75rem;
        padding-inline: clamp(1.5rem, 5vw, 2.5rem);
      }

      .m-apps__kicker {
        font-size: 0.6rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
      }

      .m-apps__title {
        font-size: clamp(1.6rem, 7vw, 2.2rem);
        font-weight: 400;
        letter-spacing: -0.03em;
        color: #fff;
        line-height: 1;
      }

      /* Carousel: track fills full width, chevrons float above at right edge */
      .m-apps__carousel {
        position: relative;
      }

      .m-apps__track {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        /* proximity (not mandatory) so the last phone can rest flush against
           the right border instead of snapping back inward. */
        scroll-snap-type: x proximity;
        scroll-padding-left: clamp(1.5rem, 5vw, 2.5rem);
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        gap: clamp(1rem, 4vw, 1.5rem);
        /* Left inset keeps the first phone off the border at rest; zero right
           inset lets phones scroll right up to the edge. */
        padding: 0 0 4px clamp(1.5rem, 5vw, 2.5rem);
      }
      .m-apps__track::-webkit-scrollbar { display: none; }

      .m-app {
        flex: none;
        /* Each item is half the viewport minus the track's left inset minus half
           the gap, for a balanced two-up at rest. Using vw avoids the
           %-in-scrollable-flex unreliability. */
        width: calc(50vw - clamp(1.5rem, 5vw, 2.5rem) - 0.5rem);
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
      }

      .m-app .phone {
        width: 100%;
        box-shadow: 0 16px 36px -16px rgba(0,0,0,0.6);
      }

      .m-app__name {
        font-size: 0.85rem;
        color: #fff;
        text-align: center;
      }

      /* Chevrons float at the right/left of the carousel, centered on the phone column */
      .m-apps__chevron {
        position: absolute;
        top: 38%;
        transform: translateY(-50%);
        z-index: 2;
        width: 34px; height: 34px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(255,255,255,0.08);
        color: #fff;
        font-size: 1.1rem;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: background 0.15s, border-color 0.15s, opacity 0.2s;
        -webkit-tap-highlight-color: transparent;
        padding: 0;
        line-height: 1;
      }
      .m-apps__chevron:hover { background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.4); }
      #m-apps-prev { left: calc(clamp(1.5rem, 5vw, 2.5rem) - 17px); opacity: 0; pointer-events: none; }
      #m-apps-next { right: calc(clamp(1.5rem, 5vw, 2.5rem) - 17px); }

      /* Lightbox sits above the fixed mobile hero image */
      .lb { z-index: 50; }
    }
  </style>
</head>
<body>

  <a href={switchHref} class="lang-switch">{t.langSwitch}</a>

  <!-- ─── SECTION 1 ─── -->
  <section class="s1">
    <h1 class="s1__title">
      <span class="s1__line-clip"><span class="s1__line-body">Armand</span></span>
      <span class="s1__line-clip"><span class="s1__line-body s1__line-body--2">Collier</span></span>
    </h1>
    <p class="s1__desc">{t.heroDesc}</p>
    <div class="s1__lower">
      <div class="s1__image-wrap">
        <div class="s1__image">
          <img src={`${base}previews/ascii-art.png`} alt="" aria-hidden="true" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── MOBILE PROJECTS (vertical list, hidden on desktop) ─── -->
  <div class="m-proj">
    <ul class="m-proj__list">
      {indexProjects.map((p) => (
        <li class="m-proj__item">
          {p.video ? (
            <video class="m-proj__video" src={`${base}previews/${p.video}`} poster={`${base}previews/${p.video.replace('.mp4', '-poster.jpg')}`} muted loop playsinline disablepictureinpicture></video>
          ) : (
            <img class="m-proj__video" src={`${base}previews/${p.image}`} alt="" />
          )}
          <span class="m-proj__meta">{p[lang].meta}</span>
          <h3 class="m-proj__title">{p.title}</h3>
          <p class="m-proj__desc">{p[lang].desc}</p>
          {(p.href || p.github) ? (
            <div class="m-proj__links">
              {p.href && (
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="m-proj__link">↗ Live</a>
              )}
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener noreferrer" class="m-proj__link">GitHub</a>
              )}
            </div>
          ) : null}
        </li>
      ))}
    </ul>

    <!-- mobile apps grid -->
    <div class="m-apps">
      <div class="m-apps__head">
        <h2 class="m-apps__title">{t.mobileTitle}</h2>
      </div>
      <div class="m-apps__carousel">
        <button class="m-apps__chevron" id="m-apps-prev" type="button" aria-label="Previous">&#x2039;</button>
        <div class="m-apps__track" id="m-apps-track">
          {apps.map((a, ai) => (
            <div class="m-app">
              <button
                class={`phone app-trigger${a.needsBorders ? '' : ' phone--flat'}`}
                type="button"
                data-app={ai}
                aria-label={`${a.name} — ${a[lang].tagline}`}
              >
                <span class="phone__screen">
                  <img src={`${base}${a.screens[0].src}`} alt={a.screens[0].alt} loading="lazy" />
                </span>
              </button>
              <span class="m-app__name">{a.name}</span>
            </div>
          ))}
        </div>
        <button class="m-apps__chevron" id="m-apps-next" type="button" aria-label="Next">&#x203A;</button>
      </div>
    </div>

    <div class="m-proj__fade" aria-hidden="true"></div>
    <div class="m-proj__contact">
      <a href="mailto:armandcollier24@gmail.com" class="m-proj__contact-link">armandcollier24@gmail.com</a>
      <a href="https://github.com/armandParser" target="_blank" rel="noopener noreferrer" class="m-proj__contact-link">github.com/armandParser</a>
      <a href={switchHref} class="m-proj__lang-switch">{t.langSwitch}</a>
    </div>
  </div>

  <!-- scroll space: image fully expands here before s2 enters -->
  <div class="s1-scroll-space" aria-hidden="true"></div>

  <!-- ─── PROJECTS OVERLAY ─── -->
  <div class="proj-overlay" id="proj-overlay" aria-hidden="true">
    <ul class="proj-list" id="proj-list">
      {indexProjects.map((p) => (
        <li class="proj-card">
          {p.video ? (
            <video class="proj-video" src={`${base}previews/${p.video}`} poster={`${base}previews/${p.video.replace('.mp4', '-poster.jpg')}`} muted loop playsinline disablepictureinpicture></video>
          ) : (
            <img class="proj-video" src={`${base}previews/${p.image}`} alt="" />
          )}
          <span class="proj-meta">{p[lang].meta}</span>
          <h3 class="proj-title">{p.title}</h3>
          <p class="proj-desc">{p[lang].desc}</p>
          {(p.href || p.github) ? (
            <div class="proj-links">
              {p.href && (
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="proj-link">↗ Live</a>
              )}
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener noreferrer" class="proj-link">GitHub</a>
              )}
            </div>
          ) : null}
        </li>
      ))}
    </ul>
  </div>

  <!-- ─── MOBILE APPS SECTION (desktop band) ─── -->
  <!-- The caption tops this section so it peeks up under the projects rail,
       reading as a caption for the projects above. The apps title sits below
       the phones. -->
  <section class="apps" id="apps">
    <p class="apps__caption">{t.indexTagline}</p>
    <div class="apps__row">
      {apps.map((a, ai) => (
        <div class="app">
          <button
            class={`phone app-trigger${a.needsBorders ? '' : ' phone--flat'}`}
            type="button"
            data-app={ai}
            aria-label={`${a.name} — ${a[lang].tagline}`}
          >
            <span class="phone__screen">
              <img src={`${base}${a.screens[0].src}`} alt={a.screens[0].alt} loading="lazy" />
            </span>
          </button>
          <span class="app__name">{a.name}</span>
          <p class="app__tagline">{a[lang].tagline}</p>
        </div>
      ))}
    </div>
    <div class="apps__head">
      <h2 class="apps__title">{t.mobileTitle}</h2>
      <span class="apps__hint">{t.mobileHint}</span>
    </div>
  </section>

  <!-- ─── SECTION 2 ─── -->
  <section class="s2">
    <p class="s2__tagline">
      <!-- <span class="s2__tagline-inner">{t.indexTagline}</span> -->
      <span class="s2__contact-title" aria-hidden="true">{t.contact}</span>
    </p>
  </section>

  <div class="contact-cta" id="contact-cta" aria-hidden="true">
    <a href="mailto:armandcollier24@gmail.com" class="contact-cta__link">armandcollier24@gmail.com</a>
    <a href="https://github.com/armandParser" target="_blank" rel="noopener noreferrer" class="contact-cta__link">github.com/armandParser</a>
  </div>

  <!-- ─── APP LIGHTBOX ─── -->
  <script type="application/json" id="apps-data" is:inline set:html={JSON.stringify(appsData)}></script>
  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="App screenshots" aria-hidden="true">
    <button class="lb__close" id="lb-close" type="button" aria-label={t.lbClose}>✕</button>
    <button class="lb__btn lb__btn--prev" id="lb-prev" type="button" aria-label={t.lbPrev}>‹</button>
    <button class="lb__btn lb__btn--next" id="lb-next" type="button" aria-label={t.lbNext}>›</button>
    <div class="lb__stage">
      <div class="lb__phone" id="lb-phone">
        <!-- <span class="lb__island" aria-hidden="true"></span> -->
        <span class="lb__screen"><img id="lb-img" src="" alt="" /></span>
      </div>
      <div class="lb__caption">
        <div class="lb__caption-name" id="lb-name"></div>
        <div class="lb__caption-tag" id="lb-tag"></div>
      </div>
      <div class="lb__dots" id="lb-dots"></div>
    </div>
  </div>

  <script>
    (function () {
      // The mobile/desktop split below is chosen once, at load, from
      // window.innerWidth — but the CSS uses live media queries. If the
      // viewport crosses the 720px breakpoint without a reload (devtools
      // device switch, window resize, phone rotation), JS and CSS disagree:
      // the desktop scroll-lock then runs under mobile CSS and pins the page
      // a few projects in. Reload on any crossing so the matching branch runs.
      const MOBILE_BP = 720;
      const loadedMobile = window.innerWidth <= MOBILE_BP;
      let bpReloadTimer: number | undefined;
      window.addEventListener('resize', () => {
        if ((window.innerWidth <= MOBILE_BP) === loadedMobile) return;
        clearTimeout(bpReloadTimer);
        bpReloadTimer = window.setTimeout(() => location.reload(), 150);
      }, { passive: true });

      // ── Mobile: video autoplay + apps carousel chevrons ──
      if (window.innerWidth <= 720) {
        const mobileVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('video.m-proj__video'));
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          });
        }, { threshold: 0.3 });
        mobileVideos.forEach((v) => obs.observe(v));

        const track   = document.getElementById('m-apps-track') as HTMLElement | null;
        const btnPrev = document.getElementById('m-apps-prev')  as HTMLButtonElement | null;
        const btnNext = document.getElementById('m-apps-next')  as HTMLButtonElement | null;
        if (track && btnPrev && btnNext) {
          const stepSize = () => {
            const item = track.querySelector<HTMLElement>('.m-app');
            if (!item) return track.clientWidth / 2;
            const gap = parseFloat(getComputedStyle(track).gap) || 0;
            return item.offsetWidth + gap;
          };
          const syncChevrons = () => {
            const atStart = track.scrollLeft <= 4;
            const atEnd   = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
            btnPrev.style.opacity       = atStart ? '0' : '1';
            btnPrev.style.pointerEvents = atStart ? 'none' : 'auto';
            btnNext.style.opacity       = atEnd   ? '0' : '1';
            btnNext.style.pointerEvents = atEnd   ? 'none' : 'auto';
          };
          btnPrev.addEventListener('click', () => track.scrollBy({ left: -stepSize(), behavior: 'smooth' }));
          btnNext.addEventListener('click', () => track.scrollBy({ left:  stepSize(), behavior: 'smooth' }));
          track.addEventListener('scroll', syncChevrons, { passive: true });
          syncChevrons();
        }

        return;
      }

      // ── Desktop only from here ──
      const imageWrap    = document.querySelector('.s1__image-wrap') as HTMLElement;
      const lower        = document.querySelector('.s1__lower')      as HTMLElement;
      const overlayEl    = document.getElementById('proj-overlay')   as HTMLElement;
      const listEl       = document.getElementById('proj-list')      as HTMLElement;
      const contactCta   = document.getElementById('contact-cta')    as HTMLElement;
      if (!imageWrap || !lower || !overlayEl || !listEl) return;

      function showContact() {
        document.body.classList.add('contact-active');
        if (contactCta) { contactCta.classList.add('is-active'); contactCta.removeAttribute('aria-hidden'); }
      }
      function hideContact() {
        document.body.classList.remove('contact-active');
        if (contactCta) { contactCta.classList.remove('is-active'); contactCta.setAttribute('aria-hidden', 'true'); }
      }

      const EXPANSION_PX = window.innerHeight;

      // Image expansion state
      let triggerScrollY: number | null = null;
      let naturalTop:     number | null = null;
      let naturalLeft:    number | null = null;
      let naturalRight:   number | null = null;

      // Overlay / scroll-lock state
      let overlayActive    = false;
      let overlayDismissed = false;
      let savedScrollY     = 0;
      let overlayScrollY   = 0;

      /* ── scroll lock ── */
      function lockScroll() {
        savedScrollY = window.scrollY;
        Object.assign(document.body.style, {
          overflow: 'hidden',
          position: 'fixed',
          top: `-${savedScrollY}px`,
          width: '100%',
        });
      }

      function unlockScroll(targetY = savedScrollY) {
        Object.assign(document.body.style, {
          overflow: '', position: '', top: '', width: '',
        });
        window.scrollTo(0, targetY);
      }

      /* ── video visibility ── */
      const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('video.proj-video'));

      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      }, { root: listEl, threshold: 0.25 });

      videos.forEach((v) => videoObserver.observe(v));

      function pauseAllVideos() { videos.forEach((v) => v.pause()); }

      function playVisibleVideos() {
        const lRect = listEl.getBoundingClientRect();
        videos.forEach((v) => {
          const r = v.getBoundingClientRect();
          if (r.right > lRect.left && r.left < lRect.right) v.play().catch(() => {});
        });
      }

      /* ── overlay ── */
      function showOverlay() {
        listEl.scrollLeft = 0;
        overlayEl.classList.add('is-active');
        overlayEl.removeAttribute('aria-hidden');
        overlayActive = true;
        lockScroll();
        requestAnimationFrame(() => requestAnimationFrame(playVisibleVideos));
      }

      function hideOverlay(dismissed: boolean, targetY?: number) {
        overlayEl.classList.remove('is-active');
        overlayEl.setAttribute('aria-hidden', 'true');
        overlayActive = false;
        pauseAllVideos();
        if (dismissed) { overlayDismissed = true; showContact(); }
        unlockScroll(targetY);
      }

      // Forward exit from the projects rail → release into the apps section.
      // A brief delay lets the overlay's opacity transition start before the
      // scroll snap, so the full-screen fade masks the position change.
      const appsEl = document.getElementById('apps') as HTMLElement | null;
      function exitToApps() {
        overlayEl.classList.remove('is-active');
        overlayEl.setAttribute('aria-hidden', 'true');
        overlayActive = false;
        pauseAllVideos();
        overlayDismissed = true;
        const target = appsEl ? appsEl.offsetTop : savedScrollY;
        setTimeout(() => unlockScroll(target), 80);
      }

      /* ── image reset ── */
      function resetImage() {
        Object.assign(imageWrap.style, {
          position: '', top: '', bottom: '', left: '', right: '', zIndex: '',
        });
      }

      /* ── main scroll handler (desktop only) ── */
      function update() {
        // Never run the desktop expand/lock machinery at mobile width — guards
        // the brief window before a breakpoint-crossing reload completes.
        if (window.innerWidth <= MOBILE_BP) return;
        if (overlayActive) return;
        const vh = window.innerHeight;
        const vw = window.innerWidth;

        if (triggerScrollY === null) {
          const rect   = imageWrap.getBoundingClientRect();
          const center = (rect.top + rect.bottom) / 2;
          if (rect.bottom <= 0 || center > vh / 2) return;
          triggerScrollY = window.scrollY;
          naturalTop   = rect.top;
          naturalLeft  = rect.left;
          naturalRight = vw - rect.right;
        }

        const extraScroll = window.scrollY - triggerScrollY!;

        if (extraScroll < 0) {
          // Scrolled back above the trigger: show the image in its natural
          // (absolute) position. Keep triggerScrollY/natural* intact so the
          // next downward scroll re-fixes at exactly the same boundary —
          // nulling them here caused a per-frame re-arm/reset oscillation
          // (the white ↔ image flicker). The resize handler re-arms instead.
          overlayDismissed = false;
          hideContact();
          resetImage();
          return;
        }

        const progress = Math.min(1, extraScroll / EXPANSION_PX);

        if (progress < 0.98 && overlayDismissed) { overlayDismissed = false; hideContact(); }

        const t = progress >= 0.99 ? 0 : (1 - progress);

        Object.assign(imageWrap.style, {
          position: 'fixed',
          top:    Math.round(naturalTop!   * t) + 'px',
          left:   Math.round(naturalLeft!  * t) + 'px',
          right:  Math.round(naturalRight! * t) + 'px',
          bottom: '0',
          zIndex: '0',
        });

        if (progress >= 0.99 && !overlayActive && !overlayDismissed) {
          showOverlay();
        } else if (progress < 0.99 && overlayActive) {
          hideOverlay(false);
        }
      }

      /* ── wheel: redirect to horizontal list when overlay active ── */
      window.addEventListener('wheel', (e) => {
        if (!overlayActive) return;
        e.preventDefault();

        const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        const maxScroll = listEl.scrollWidth - listEl.clientWidth;

        if (delta > 0 && listEl.scrollLeft >= maxScroll - 5) {
          exitToApps();
        } else if (delta < 0 && listEl.scrollLeft <= 5) {
          hideOverlay(false, triggerScrollY! + Math.floor(EXPANSION_PX * 0.93));
        } else {
          listEl.scrollLeft += delta;
        }
      }, { passive: false });

      /* ── touch: whole overlay swipeable on mobile ── */
      let touchStartX = 0;
      let touchStartY = 0;
      let touchLastX  = 0;

      overlayEl.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchLastX  = e.touches[0].clientX;
        if (overlayActive) playVisibleVideos();
      }, { passive: true });

      overlayEl.addEventListener('touchmove', (e) => {
        if (!overlayActive) return;
        if (listEl.contains(e.target as Node)) {
          touchLastX = e.touches[0].clientX;
          return;
        }
        e.preventDefault();
        const currentX = e.touches[0].clientX;
        listEl.scrollLeft += touchLastX - currentX;
        touchLastX = currentX;
      }, { passive: false });

      listEl.addEventListener('scroll', () => {
        if (overlayActive) playVisibleVideos();
      }, { passive: true });

      overlayEl.addEventListener('touchend', (e) => {
        if (!overlayActive) return;
        const dx = touchStartX - e.changedTouches[0].clientX;
        const dy = touchStartY - e.changedTouches[0].clientY;
        const absX = Math.abs(dx);
        const absY = Math.abs(dy);
        const maxScroll = listEl.scrollWidth - listEl.clientWidth;

        if (absY > absX && absY > 40) {
          if (dy > 0) {
            if (listEl.scrollLeft >= maxScroll - 30) {
              exitToApps();
            } else {
              listEl.scrollBy({ left: window.innerWidth * 0.75, behavior: 'smooth' });
            }
          } else {
            hideOverlay(false, overlayScrollY - Math.floor(window.innerHeight * 0.08));
          }
          return;
        }

        if (dx > 40 && listEl.scrollLeft >= maxScroll - 30) {
          exitToApps();
        } else if (dx < -40 && listEl.scrollLeft <= 30) {
          hideOverlay(false, overlayScrollY - Math.floor(window.innerHeight * 0.08));
        }
      }, { passive: true });

      window.addEventListener('scroll', update, { passive: true });

      // Phones row: fade-slide in when scrolled into view
      const appsRowEl = document.querySelector('.apps__row') as HTMLElement | null;
      if (appsRowEl) {
        const rowIO = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { appsRowEl.classList.add('is-visible'); rowIO.disconnect(); } });
        }, { threshold: 0.15 });
        rowIO.observe(appsRowEl);
      }

      // Contact reveal: once the projects rail has been passed, entering
      // section 2 (the finale) morphs the tagline and reveals the contact CTA.
      const s2El = document.querySelector('.s2') as HTMLElement | null;
      if (s2El) {
        const contactIO = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (overlayActive || !overlayDismissed) return;
            if (entry.isIntersecting && entry.intersectionRatio >= 0.55) showContact();
            else if (entry.intersectionRatio < 0.55) hideContact();
          });
        }, { threshold: [0, 0.55, 1] });
        contactIO.observe(s2El);
      }

      window.addEventListener('resize', () => {
        if (overlayActive) hideOverlay(false);
        overlayDismissed = false;
        hideContact();
        triggerScrollY = null;
        naturalTop = naturalLeft = naturalRight = null;
        resetImage();
      }, { passive: true });
    })();
  </script>

  <!-- ─── APP LIGHTBOX (self-contained, all viewports) ─── -->
  <script>
    (function () {
      const lb = document.getElementById('lb') as HTMLElement | null;
      const dataEl = document.getElementById('apps-data');
      if (!lb || !dataEl) return;

      type Screen = { src: string; alt: string };
      type App = { name: string; tagline: string; needsBorders: boolean; screens: Screen[] };
      let apps: App[] = [];
      try { apps = JSON.parse(dataEl.textContent || '[]'); } catch { return; }
      if (!apps.length) return;

      const phone   = document.getElementById('lb-phone') as HTMLElement;
      const img     = document.getElementById('lb-img')   as HTMLImageElement;
      const nameEl  = document.getElementById('lb-name')  as HTMLElement;
      const tagEl   = document.getElementById('lb-tag')   as HTMLElement;
      const dotsEl  = document.getElementById('lb-dots')  as HTMLElement;
      const btnPrev = document.getElementById('lb-prev')  as HTMLButtonElement;
      const btnNext = document.getElementById('lb-next')  as HTMLButtonElement;
      const btnClose = document.getElementById('lb-close') as HTMLButtonElement;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const EASE = 'cubic-bezier(0.16,1,0.3,1)';
      const DUR = 420;

      let appIdx = 0;
      let screenIdx = 0;
      let sourceEl: Element | null = null;
      let lastFocus: HTMLElement | null = null;

      function renderScreen() {
        const app = apps[appIdx];
        const screen = app.screens[screenIdx];
        phone.classList.toggle('lb__phone--flat', !app.needsBorders);
        img.src = screen.src;
        img.alt = screen.alt;
        nameEl.textContent = app.name;
        tagEl.textContent = app.tagline;

        dotsEl.innerHTML = '';
        app.screens.forEach((_, i) => {
          const b = document.createElement('button');
          b.className = 'lb__dot' + (i === screenIdx ? ' is-active' : '');
          b.type = 'button';
          b.setAttribute('aria-label', 'Screen ' + (i + 1));
          b.addEventListener('click', () => { screenIdx = i; renderScreen(); });
          dotsEl.appendChild(b);
        });

        const multi = app.screens.length > 1;
        btnPrev.style.display = multi ? '' : 'none';
        btnNext.style.display = multi ? '' : 'none';
      }

      function nav(dir: number) {
        const n = apps[appIdx].screens.length;
        screenIdx = (screenIdx + dir + n) % n;
        renderScreen();
      }

      // Shared-element FLIP: scale the lightbox phone from the tapped phone's rect.
      function flipFrom(el: Element | null) {
        if (reduce || !el) return;
        const target = phone.getBoundingClientRect();
        const src = el.getBoundingClientRect();
        const scale = src.width / target.width;
        const tx = src.left - target.left;
        const ty = src.top - target.top;
        phone.style.transition = 'none';
        phone.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
        void phone.offsetWidth; // reflow
        phone.style.transition = `transform ${DUR}ms ${EASE}`;
        phone.style.transform = 'translate(0,0) scale(1)';
      }

      function open(idx: number, el: Element) {
        appIdx = idx; screenIdx = 0;
        sourceEl = el;
        lastFocus = document.activeElement as HTMLElement | null;
        renderScreen();
        lb!.classList.add('is-open');
        lb!.removeAttribute('aria-hidden');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => flipFrom(el));
        btnClose.focus({ preventScroll: true });
      }

      function close() {
        document.body.style.overflow = '';
        if (!reduce && sourceEl) {
          const target = phone.getBoundingClientRect();
          const src = sourceEl.getBoundingClientRect();
          const scale = src.width / target.width;
          const tx = src.left - target.left;
          const ty = src.top - target.top;
          phone.style.transition = `transform ${DUR}ms ${EASE}`;
          phone.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
        }
        lb!.classList.remove('is-open');
        lb!.setAttribute('aria-hidden', 'true');
        window.setTimeout(() => {
          phone.style.transition = 'none';
          phone.style.transform = '';
        }, reduce ? 0 : DUR);
        if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
      }

      document.querySelectorAll('.app-trigger').forEach((el) => {
        el.addEventListener('click', () => open(parseInt(el.getAttribute('data-app') || '0', 10), el));
      });

      btnPrev.addEventListener('click', () => nav(-1));
      btnNext.addEventListener('click', () => nav(1));
      btnClose.addEventListener('click', close);
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

      document.addEventListener('keydown', (e) => {
        if (!lb!.classList.contains('is-open')) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') nav(-1);
        else if (e.key === 'ArrowRight') nav(1);
      });

      // Swipe through screens on touch
      let sx = 0, sy = 0;
      phone.addEventListener('touchstart', (e) => {
        sx = e.touches[0].clientX; sy = e.touches[0].clientY;
      }, { passive: true });
      phone.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) nav(dx < 0 ? 1 : -1);
      }, { passive: true });
    })();
  </script>

</body>
</html>
