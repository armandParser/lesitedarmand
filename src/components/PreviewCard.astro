---
interface Props {
  title: string;
  description: string;
  meta: string;
  href?: string;
  image?: string;
  video?: string;
  github?: string;
  showFooter?: boolean;
  isMobile?: boolean;
}
const { title, description, meta, href, image, video, github, showFooter, isMobile } = Astro.props;
const domain = href?.replace(/^https?:\/\//, '').replace(/\/$/, '') ?? '';

// Fetch OG image at build time only when no video and no image prop
let ogImage: string | null = image ?? null;
if (href && !video && !ogImage) {
  try {
    const res = await fetch(href, { signal: AbortSignal.timeout(6000) });
    const html = await res.text();
    const match =
      html.match(/<meta[^>]+property=["']og:image["'][^>]+content=["']([^"']+)["']/i) ??
      html.match(/<meta[^>]+content=["']([^"']+)["'][^>]+property=["']og:image["']/i);
    if (match?.[1]) {
      const raw = match[1];
      ogImage = raw.startsWith('http') ? raw : new URL(raw, href).toString();
    }
  } catch {
    // Build continues without preview image
  }
}
---

<div class="preview-card">
  {href
    ? (
      <a class="preview-card__link" href={href} target="_blank" rel="noopener noreferrer" aria-label={title}>
        <div class="preview-card__viewport">
          {video
            ? <video data-src={video} muted playsinline preload="none" loop={false} aria-label={title} />
            : ogImage
              ? <img src={ogImage} alt={title} width="600" height="315" loading="lazy" decoding="async" style={isMobile ? 'padding: 12px 0' : undefined} />
              : <span class="preview-card__domain">{domain}</span>
          }
        </div>
      </a>
    )
    : (
      <div class="preview-card__link preview-card__link--static">
        <div class="preview-card__viewport">
          {video
            ? <video data-src={video} muted playsinline preload="none" loop={false} aria-label={title} />
            : ogImage
              ? <img src={ogImage} alt={title} width="600" height="315" loading="lazy" decoding="async" style={isMobile ? 'padding: 12px 0' : undefined} />
              : null
          }
        </div>
      </div>
    )
  }
  {(showFooter || github) && (
    <div class="preview-card__foot">
      <span class="preview-card__name">{title}</span>
      {github && (
        <a class="preview-card__gh" href={github} target="_blank" rel="noopener noreferrer">
          GitHub <span class="arrow">↗</span>
        </a>
      )}
    </div>
  )}
  {description && (
    <p class="preview-card__desc">{description}</p>
  )}
</div>

<style>
  .preview-card {
    display: flex;
    flex-direction: column;
    position: relative;
    transition: border-color 0.25s var(--tween), transform 0.38s var(--tween), box-shadow 0.38s var(--tween);
    overflow: hidden;
  }
  .preview-card:hover {
    transform: translateY(-5px) scale(1.03);
    z-index: 2;
    box-shadow:
      0 20px 48px rgba(10, 20, 12, 0.16),
      0 6px 16px rgba(10, 20, 12, 0.1);
  }

  .preview-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    background: transparent;
    flex-shrink: 0;
  }
  .preview-card__link--static {
    cursor: default;
  }

  .preview-card__viewport {
    position: relative;
    height: 180px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    /* background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 12px,
        color-mix(in srgb, var(--rule) 40%, transparent) 12px,
        color-mix(in srgb, var(--rule) 40%, transparent) 13px
      ); */
  }

  .preview-card__desc {
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--mute);
    margin: 0;
    padding: 0.6rem 0.75rem 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .preview-card__viewport img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
    display: block;
    transition: transform 0.4s var(--tween);
  }
  .preview-card:hover .preview-card__viewport img { transform: scale(1.03); }


  .preview-card__viewport video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: opacity 0.05s;
  }

  @keyframes video-glitch {
    0%   { opacity: 1;    transform: none; }
    12%  { opacity: 0.15; transform: translateX(4px) skewX(3deg); }
    24%  { opacity: 0.9;  transform: translateX(-3px); }
    38%  { opacity: 0.05; transform: translateX(5px) skewX(-4deg) scaleY(1.01); }
    52%  { opacity: 0.7;  transform: none; }
    66%  { opacity: 0;    transform: translateX(-4px) skewX(2deg); }
    80%  { opacity: 0.3;  transform: none; }
    100% { opacity: 0;    transform: none; }
  }

  .preview-card__viewport video.is-glitching {
    animation: video-glitch 0.7s steps(2, end) forwards;
  }

  .preview-card__foot {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem 0.6rem 0;
    /* background: var(--bone); */
    flex-shrink: 0;
  }
  .preview-card__name {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .preview-card__gh {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .preview-card__gh:hover { text-decoration: underline; }

  .preview-card__domain {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--mute);
    background: var(--bone);
    padding: 0.25em 0.6em;
    border: var(--rule-w) solid var(--rule);
  }
</style>

<script>
  function initPreviewCards() {
  document.querySelectorAll<HTMLElement>('.preview-card').forEach(card => {
    const video = card.querySelector<HTMLVideoElement>('video[data-src]');
    if (!video) return;

    const trigger = card.querySelector('.preview-card__link') ?? card;
    let isHovering = false;
    let isGlitching = false;
    let srcLoaded = false;

    function loadSrc() {
      if (srcLoaded) return;
      srcLoaded = true;
      video.src = (video as HTMLVideoElement & { dataset: DOMStringMap }).dataset.src!;
      video.removeAttribute('data-src');
      // Seek to first frame once metadata is ready so the thumbnail is visible
      video.addEventListener('loadedmetadata', () => { video.currentTime = 0.001; }, { once: true });
      video.load(); 
    }

    // Load src when card approaches viewport — shows first frame before any interaction
    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        loadSrc();
        observer.disconnect();
      }
    }, { rootMargin: '300px' });
    observer.observe(card);

    video.addEventListener('timeupdate', () => {
      if (!isHovering || isGlitching || !video.duration) return;
      if (video.currentTime >= video.duration - 0.75) {
        isGlitching = true;
        video.classList.add('is-glitching');
        setTimeout(() => {
          video.classList.remove('is-glitching');
          isGlitching = false;
          if (isHovering) {
            video.currentTime = 0;
            video.play();
          }
        }, 700);
      }
    });

    trigger.addEventListener('mouseenter', () => {
      isHovering = true;
      if (!srcLoaded) {
        // User hovered before IntersectionObserver fired — load immediately
        loadSrc();
        video.addEventListener('canplay', () => { video.currentTime = 0; video.play(); }, { once: true });
      } else {
        video.currentTime = 0;
        video.play();
      }
    });

    trigger.addEventListener('mouseleave', () => {
      isHovering = false;
      isGlitching = false;
      video.classList.remove('is-glitching');
      video.pause();
      video.currentTime = 0;
    });
  });
  }

  document.addEventListener('astro:page-load', initPreviewCards);
</script>
