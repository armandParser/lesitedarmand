---
interface Props {
  size?: number;
  seed?: number;
}
const { size = 320, seed = 4 } = Astro.props;
const id = 'd' + Math.random().toString(36).slice(2, 8);
---

<div class="dither-wrap" style={`--shape-size: ${size}px;`}>
  <svg
    class="dither-shape"
    viewBox="0 0 240 240"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Dithered sphere"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <radialGradient id={`sg-${id}`} cx="36%" cy="30%" r="78%">
        <stop offset="0%"   stop-color="#ffffff" />
        <stop offset="22%"  stop-color="#dcdcdc" />
        <stop offset="55%"  stop-color="#5a5a5a" />
        <stop offset="85%"  stop-color="#0a0a0a" />
        <stop offset="100%" stop-color="#000000" />
      </radialGradient>

      <radialGradient id={`rim-${id}`} cx="78%" cy="80%" r="55%">
        <stop offset="0%"  stop-color="#ffffff" stop-opacity="0" />
        <stop offset="78%" stop-color="#ffffff" stop-opacity="0" />
        <stop offset="92%" stop-color="#ffffff" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>

      <filter id={`dith-${id}`} x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.92"
          numOctaves="2"
          seed={seed}
          stitchTiles="stitch"
          result="n"
        />
        <feColorMatrix
          in="n"
          values="0 0 0 0 0.5
                  0 0 0 0 0.5
                  0 0 0 0 0.5
                  0 0 0 0 1"
          result="ng"
        />
        <feComposite in="SourceGraphic" in2="ng" operator="arithmetic"
          k1="0" k2="1" k3="-1" k4="0.5" result="d" />
        <feComponentTransfer in="d">
          <feFuncR type="discrete" tableValues="0 1" />
          <feFuncG type="discrete" tableValues="0 1" />
          <feFuncB type="discrete" tableValues="0 1" />
        </feComponentTransfer>
      </filter>

      <mask id={`m-${id}`} maskUnits="userSpaceOnUse">
        <rect width="240" height="240" fill="black" />
        <g filter={`url(#dith-${id})`}>
          <circle cx="120" cy="120" r="96" fill={`url(#sg-${id})`} />
        </g>
      </mask>

      <mask id={`mrim-${id}`} maskUnits="userSpaceOnUse">
        <rect width="240" height="240" fill="black" />
        <g filter={`url(#dith-${id})`}>
          <circle cx="120" cy="120" r="96" fill={`url(#rim-${id})`} />
        </g>
      </mask>

      <pattern id={`grid-${id}`} x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
        <path d="M 8 0 L 0 0 L 0 8" fill="none" class="grid-stroke" stroke-width="0.5" />
      </pattern>
    </defs>

    <g class="reg" stroke-width="0.75" fill="none">
      <path d="M 6 18 L 6 6 L 18 6" />
      <path d="M 234 18 L 234 6 L 222 6" />
      <path d="M 6 222 L 6 234 L 18 234" />
      <path d="M 234 222 L 234 234 L 222 234" />
    </g>

    <g class="orbit-group">
      <ellipse cx="120" cy="120" rx="112" ry="40" class="orbit" fill="none" stroke-width="0.75" stroke-dasharray="2 3" />
    </g>

    <g class="ink-fill" mask={`url(#m-${id})`}>
      <rect width="240" height="240" />
    </g>

    <g class="bone-fill" mask={`url(#mrim-${id})`}>
      <rect width="240" height="240" />
    </g>

    <circle cx="120" cy="120" r="96" class="orb-ring" fill="none" stroke-width="0.75" />

    <g class="satellite">
      <circle cx="218" cy="62" r="3.5" class="sat-dot" />
      <circle cx="218" cy="62" r="7" class="sat-ring" fill="none" stroke-width="0.5" />
    </g>

    <g class="ticks" font-family="JetBrains Mono, monospace" font-size="6.5" letter-spacing="0.1em">
      <text x="6" y="128" class="tick-text">0xR1</text>
      <text x="206" y="128" class="tick-text">∞</text>
      <text x="108" y="14" class="tick-text">N</text>
      <text x="108" y="232" class="tick-text">S</text>
    </g>
  </svg>
</div>

<style>
  .dither-wrap {
    width: 100%;
    height: 100%;
    max-width: var(--shape-size);
    max-height: var(--shape-size);
    aspect-ratio: 1;
    position: relative;
  }
  .dither-shape {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .ink-fill rect { fill: var(--ink); }
  .bone-fill rect { fill: var(--bone); mix-blend-mode: screen; opacity: 0.55; }
  @media (prefers-color-scheme: dark) {
    .bone-fill rect { mix-blend-mode: lighten; opacity: 0.7; }
  }
  .orb-ring { stroke: var(--ink); opacity: 0.85; }
  .reg { stroke: var(--mute); opacity: 0.7; }
  .orbit { stroke: var(--accent); opacity: 0.55; }
  .sat-dot { fill: var(--accent); }
  .sat-ring { stroke: var(--accent); opacity: 0.6; }
  .tick-text { fill: var(--mute); text-transform: uppercase; }
  .grid-stroke { stroke: var(--rule); }

  .orbit-group {
    transform-origin: 120px 120px;
    transform-box: fill-box;
  }
  .satellite {
    transform-origin: 120px 120px;
    transform-box: fill-box;
  }

  @keyframes orbit-rot {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes orbit-tilt {
    0%, 100% { transform: rotate(-12deg); }
    50%      { transform: rotate(12deg); }
  }
  @keyframes sat-rot {
    from { transform: rotate(0deg); }
    to   { transform: rotate(-360deg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit-group { animation: orbit-tilt 14s ease-in-out infinite; }
    .satellite   { animation: sat-rot 22s linear infinite; }
  }
</style>
