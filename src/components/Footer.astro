---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
const footerText = t(lang).footer(year);
---

<footer class="site-footer">
  <div class="shell row between">
    <span>{footerText}</span>
    <span class="row gap-2">
      <a class="link" href="https://github.com/armandParser">GitHub <span class="arrow">↗</span></a>
      <a class="link" href="mailto:armand@parser-lab.com">Email <span class="arrow">↗</span></a>
    </span>
  </div>
</footer>
