---
import Icon from '../Icon.astro';
import { site } from '../../i18n/site';
import { projects } from '../../data/projects';
import { stack } from '../../data/stack';
import type { Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = site[lang].expertise;
const titleOf = (slug: string) => projects.find((p) => p.slug === slug)?.title ?? slug;
---
<section class="section expertise" id="expertise" aria-labelledby="expertise-title">
  <div class="container">
    <header class="reveal">
      <span class="kicker">{t.kicker}</span>
      <h2 class="h2" id="expertise-title">{t.title}</h2>
      <p class="lede">{t.sub}</p>
    </header>

    <ol class="layers">
      {t.items.map((item, i) => (
        <li class="layer reveal" style={`--delay:${i * 60}ms`}>
          <span class="layer__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="layer__title">{item.title}</h3>
          <p class="layer__body">{item.body}</p>
          <ul class="layer__refs">
            {item.refs.map((slug) => (
              <li>
                <a href={`#${slug}`} class="ref" aria-label={`${t.seen} ${titleOf(slug)}`}>
                  {titleOf(slug)}
                  <Icon name="arrow-up-right" size={12} />
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <div class="stack reveal">
      <h3 class="stack__title">{t.stackTitle}</h3>
      <dl class="stack__groups">
        {stack.map((g) => (
          <div class="stack__group">
            <dt>{g.label[lang]}</dt>
            <dd>
              <ul>{g.items.map((item) => <li>{item}</li>)}</ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section class="tagline" aria-label={site[lang].tagline}>
  <div class="container">
    <p class="tagline__text" aria-hidden="true">
      {site[lang].tagline.split(' ').map((w) => <span class="tw">{w} </span>)}
    </p>
  </div>
</section>

<style>
  .expertise { background: var(--surface-2); transition: background-color 400ms var(--ease); }

  /* Editorial index: one hairline-separated row per layer, no cards. */
  .layers { list-style: none; margin-top: 48px; border-bottom: 1px solid var(--border); }
  .layer {
    display: grid; gap: 8px 24px; padding-block: 24px;
    grid-template-columns: 40px 1fr;
    grid-template-areas: 'n title' '. body' '. refs';
    border-top: 1px solid var(--border);
    transition: opacity 900ms var(--ease), filter 900ms var(--ease), transform 900ms var(--ease);
  }
  @media (min-width: 1024px) {
    .layer {
      grid-template-columns: 56px minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
      grid-template-areas: 'n title body refs';
      align-items: baseline; padding-block: 32px;
    }
  }
  .layer__n {
    grid-area: n; font-family: var(--mono); font-size: 0.75rem; line-height: 1.75rem;
    color: var(--faint); transition: color 300ms var(--ease);
  }
  .layer:hover .layer__n { color: var(--accent); }
  .layer__title { grid-area: title; font-size: 1.25rem; line-height: 1.75rem; letter-spacing: -0.01em; }
  .layer__body { grid-area: body; color: var(--muted); font-size: 0.9375rem; line-height: 1.5rem; max-width: 46ch; }
  .layer__refs { grid-area: refs; list-style: none; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  @media (min-width: 1024px) { .layer__refs { flex-direction: column; align-items: flex-start; } }
  .ref {
    display: inline-flex; align-items: center; gap: 4px;
    color: var(--text); font-size: 0.875rem; line-height: 1.5rem; text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 400ms var(--ease), color 300ms var(--ease);
  }
  .ref :global(svg) { color: var(--faint); transition: color 300ms var(--ease), transform 300ms var(--ease); }
  .ref:hover { background-size: 100% 1px; }
  .ref:hover :global(svg) { color: var(--accent); transform: translate(1px, -1px); }

  /* Toolbox: same hairline language, label on the left, plain mono list on the right. */
  .stack { margin-top: 64px; }
  .stack__title { font-family: var(--mono); font-size: 0.75rem; line-height: 1rem; font-weight: 400; color: var(--faint); text-transform: uppercase; letter-spacing: 0.08em; }
  .stack__groups { display: grid; margin-top: 16px; border-bottom: 1px solid var(--border); }
  .stack__group { display: grid; gap: 8px; padding-block: 16px; border-top: 1px solid var(--border); }
  @media (min-width: 768px) { .stack__group { grid-template-columns: 200px 1fr; gap: 24px; align-items: baseline; } }
  .stack__group dt { font-size: 0.875rem; line-height: 1.5rem; font-weight: 500; }
  .stack__group ul { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .stack__group li {
    font-family: var(--mono); font-size: 0.8125rem; line-height: 1.5rem; color: var(--muted);
    transition: color 300ms var(--ease);
  }
  .stack__group li:hover { color: var(--text); }

  /* ── Tagline: words light up one by one as they cross the reading line ── */
  .tagline { padding-block: 96px; }
  @media (min-width: 768px) { .tagline { padding-block: 128px; } }
  .tagline__text {
    max-width: 880px;
    font-size: 2.25rem; line-height: 2.5rem; font-weight: 600; letter-spacing: -0.03em;
    text-wrap: balance;
  }
  @media (min-width: 768px) { .tagline__text { font-size: 3.75rem; line-height: 1; } }
  .tw { color: color-mix(in srgb, var(--text) 25%, transparent); transition: color 700ms var(--ease); }
  .tw.is-lit { color: var(--text); }
  :global(html:not(.js)) .tw { color: var(--text); }
</style>

<script>
  const words = Array.from(document.querySelectorAll<HTMLElement>('.tw'));
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    words.forEach((w) => w.classList.add('is-lit'));
  } else {
    // A word lights up once it rises above 60% of the viewport height, and dims
    // again if the reader scrolls back up past it.
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const above = e.boundingClientRect.top < (e.rootBounds?.bottom ?? innerHeight * 0.6);
        e.target.classList.toggle('is-lit', e.isIntersecting || above);
      });
    }, { rootMargin: '0px 0px -40% 0px' });
    words.forEach((w) => io.observe(w));
  }
</script>
