---
interface Props {
  size?: number;
  seed?: number;
}
const { size = 320, seed = 7 } = Astro.props;
const id = 's' + Math.random().toString(36).slice(2, 8);
---

<div class="sun-wrap" style={`--shape-size: ${size}px;`}>
  <svg
    class="sun-shape"
    viewBox="0 0 240 240"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Sun and drifting clouds"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <radialGradient id={`sun-${id}`} cx="50%" cy="50%" r="50%">
        <stop offset="0%"   stop-color="#fff8d6" />
        <stop offset="40%"  stop-color="#ffd27a" />
        <stop offset="80%"  stop-color="#ffb347" />
        <stop offset="100%" stop-color="#e87a3a" />
      </radialGradient>

      <radialGradient id={`halo-${id}`} cx="50%" cy="50%" r="50%">
        <stop offset="60%"  stop-color="#ffd27a" stop-opacity="0" />
        <stop offset="85%"  stop-color="#ffd27a" stop-opacity="0.45" />
        <stop offset="100%" stop-color="#ffd27a" stop-opacity="0" />
      </radialGradient>

      <filter id={`grain-${id}`} x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed={seed} stitchTiles="stitch" result="n" />
        <feColorMatrix in="n" values="0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 1" result="ng" />
        <feComposite in="SourceGraphic" in2="ng" operator="arithmetic" k1="0" k2="1" k3="-0.35" k4="0.18" />
      </filter>

      <symbol id={`cloud-${id}`} viewBox="0 0 80 32">
        <path d="M14 24 Q4 24 4 16 Q4 8 14 8 Q16 2 24 2 Q34 2 36 10 Q44 6 52 12 Q62 8 68 16 Q76 16 76 22 Q76 28 68 28 L14 28 Z"
              fill="currentColor" />
      </symbol>
    </defs>

    <g class="reg" stroke-width="0.75" fill="none">
      <path d="M 6 18 L 6 6 L 18 6" />
      <path d="M 234 18 L 234 6 L 222 6" />
      <path d="M 6 222 L 6 234 L 18 234" />
      <path d="M 234 222 L 234 234 L 222 234" />
    </g>

    <g class="orbit-group">
      <ellipse cx="120" cy="120" rx="108" ry="38" class="orbit" fill="none" stroke-width="0.75" stroke-dasharray="2 3" />
    </g>

    <circle cx="120" cy="120" r="76" fill={`url(#halo-${id})`} />
    <circle cx="120" cy="120" r="58" fill={`url(#sun-${id})`} filter={`url(#grain-${id})`} />
    <circle cx="120" cy="120" r="58" class="sun-ring" fill="none" stroke-width="0.75" />

    <g class="rays" stroke-width="0.85">
      <line x1="120" y1="20"  x2="120" y2="38" />
      <line x1="120" y1="202" x2="120" y2="220" />
      <line x1="20"  y1="120" x2="38"  y2="120" />
      <line x1="202" y1="120" x2="220" y2="120" />
      <line x1="48"  y1="48"  x2="60"  y2="60" />
      <line x1="180" y1="60"  x2="192" y2="48" />
      <line x1="48"  y1="192" x2="60"  y2="180" />
      <line x1="180" y1="180" x2="192" y2="192" />
    </g>

    <g class="cloud cloud-a">
      <use href={`#cloud-${id}`} x="-40" y="0" width="80" height="32" />
    </g>
    <g class="cloud cloud-b">
      <use href={`#cloud-${id}`} x="-30" y="-8" width="60" height="24" />
    </g>

    <g class="ticks" font-family="JetBrains Mono, monospace" font-size="6.5" letter-spacing="0.1em">
      <text x="6" y="128" class="tick-text">SOL</text>
      <text x="218" y="128" class="tick-text">∞</text>
      <text x="108" y="14" class="tick-text">N</text>
      <text x="108" y="232" class="tick-text">S</text>
    </g>
  </svg>
</div>

<style>
  .sun-wrap {
    width: 100%;
    height: 100%;
    max-width: var(--shape-size);
    max-height: var(--shape-size);
    aspect-ratio: 1;
    position: relative;
  }
  .sun-shape {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .sun-ring { stroke: color-mix(in oklab, var(--accent) 65%, var(--ink)); opacity: 0.5; }
  .reg { stroke: var(--mute); opacity: 0.7; }
  .orbit { stroke: var(--leaf, var(--accent)); opacity: 0.55; }
  .rays { stroke: var(--accent); opacity: 0.7; stroke-linecap: round; }
  .tick-text { fill: var(--mute); text-transform: uppercase; }

  .cloud { color: var(--bone); opacity: 0.92; filter: drop-shadow(0 1px 0 color-mix(in oklab, var(--ink) 20%, transparent)); }
  .cloud-a { transform: translate(0px, 70px); }
  .cloud-b { transform: translate(180px, 170px); }

  .orbit-group { transform-origin: 120px 120px; transform-box: fill-box; }

  @keyframes drift-a {
    0%   { transform: translate(-60px, 70px); }
    100% { transform: translate(280px, 70px); }
  }
  @keyframes drift-b {
    0%   { transform: translate(280px, 170px); }
    100% { transform: translate(-60px, 170px); }
  }
  @keyframes orbit-tilt {
    0%, 100% { transform: rotate(-10deg); }
    50%      { transform: rotate(10deg); }
  }
  @keyframes ray-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 0.95; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .orbit-group { animation: orbit-tilt 16s ease-in-out infinite; }
    .cloud-a     { animation: drift-a 38s linear infinite; }
    .cloud-b     { animation: drift-b 52s linear infinite; }
    .rays        { animation: ray-pulse 6s ease-in-out infinite; }
  }
</style>
