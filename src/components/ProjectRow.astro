---
interface Props {
  index: number;
  title: string;
  description: string;
  meta: string;
  href?: string;
  github?: string;
}
const { index, title, description, meta, href, github } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<div class="project">
  <span class="project__num">{num}</span>
  <span class="project__title">{title}</span>
  <span class="project__desc">{description}</span>
  <span class="project__meta">
    <!-- {meta} -->
    <span class="project__links">
      {href && (
        <a href={href} target="_blank" rel="noopener noreferrer" class="project__link">
          Demo <span class="arrow">↗</span>
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="project__link">
          GitHub <span class="arrow">↗</span>
        </a>
      )}
    </span>
  </span>
</div>

<style>
  .project__links {
    display: inline-flex;
    gap: 1rem;
    margin-left: 1rem;
  }
  .project__link {
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .project__link:hover { text-decoration: underline; }
</style>
