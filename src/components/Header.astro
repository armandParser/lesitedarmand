---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="shell row between">
    <a href="/" class="brand" aria-label="Armand Collier — home">
      armand collier<span class="dot">.</span>
    </a>
    <nav aria-label="Primary">
      <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Index</a>
      <a href="/work" aria-current={isActive('/work') ? 'page' : undefined}>Work</a>
      <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
      <a href="mailto:armandcollier24@gmail.com">Contact</a>
    </nav>
  </div>
</header>
