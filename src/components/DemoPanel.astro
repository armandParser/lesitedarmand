<!-- Slide-in right panel for personal project demos -->
<div id="demo-panel" class="demo-panel" aria-hidden="true" aria-modal="true" role="dialog">
  <div class="demo-panel__backdrop"></div>
  <div class="demo-panel__sheet">
    <div class="demo-panel__bar">
      <span class="demo-panel__label">Demo</span>
      <button class="demo-panel__close" aria-label="Close demo">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <iframe id="demo-iframe" src="" title="Project demo" allow="fullscreen" loading="lazy"></iframe>
  </div>
</div>

<style>
  .demo-panel {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }
  .demo-panel.is-open { pointer-events: all; }

  .demo-panel__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 40%, transparent);
    opacity: 0;
    transition: opacity 0.3s var(--tween);
    backdrop-filter: blur(2px);
  }
  .demo-panel.is-open .demo-panel__backdrop { opacity: 1; }

  .demo-panel__sheet {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(54rem, 100%);
    display: flex;
    flex-direction: column;
    background: var(--bone);
    border-left: var(--rule-w) solid var(--rule);
    transform: translateX(100%);
    transition: transform 0.35s var(--tween);
    will-change: transform;
  }
  .demo-panel.is-open .demo-panel__sheet { transform: translateX(0); }

  .demo-panel__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.9rem;
    border-bottom: var(--rule-w) solid var(--rule);
    background: var(--bone-2, var(--bone));
    flex-shrink: 0;
  }
  .demo-panel__label {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--mute);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .demo-panel__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: none;
    border: var(--rule-w) solid var(--rule);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .demo-panel__close:hover { border-color: var(--accent); color: var(--accent); }

  #demo-iframe {
    flex: 1;
    border: none;
    width: 100%;
  }
</style>

<script>
  const panel = document.getElementById('demo-panel')!;
  const iframe = document.getElementById('demo-iframe') as HTMLIFrameElement;
  const closeBtn = panel.querySelector('.demo-panel__close')!;
  const backdrop = panel.querySelector('.demo-panel__backdrop')!;

  function openPanel(href: string) {
    iframe.src = href;
    panel.classList.add('is-open');
    panel.removeAttribute('aria-hidden');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closePanel() {
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => { iframe.src = ''; }, 350);
  }

  document.addEventListener('demo:open', (e) => {
    openPanel((e as CustomEvent<{ href: string }>).detail.href);
  });

  closeBtn.addEventListener('click', closePanel);
  backdrop.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.classList.contains('is-open')) closePanel();
  });
</script>
