---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AsciiDivider from '../components/AsciiDivider.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects.ts';
---

<Layout title="Work — Armand Collier" description="Selected projects by Armand Collier.">
  <Header />

  <main>
    <section class="hero shell" style="padding-block: clamp(3rem, 6vw, 5rem) 1.5rem;">
      <span class="eyebrow">Index / Work</span>
      <h1 class="display" style="margin-top: 1rem;">
        Work<span style="color: var(--accent);">.</span>
      </h1>
      <p class="hero__sub">
        Shipped projects, current builds, and a couple of experiments worth
        showing. Filed by year, descending.
      </p>
    </section>

    <AsciiDivider label={`${projects.length} projects`} />

    <section class="section shell" style="padding-top: 1rem;">
      <div class="projects">
        {projects.map((p, i) => (
          <ProjectRow
            index={i}
            title={p.title}
            description={p.description}
            meta={p.meta}
            href={p.href}
          />
        ))}
      </div>
    </section>

    <section class="contact shell">
      <p class="contact__big">
        Got something<br />
        <a href="mailto:armandcollier24@gmail.com">to build?<span class="caret"></span></a>
      </p>
      <div class="stack gap-2">
        <span class="eyebrow">Open for</span>
        <span>SaaS MVPs (4–8 weeks)</span>
        <span>Site redesigns</span>
        <span>Internal tools</span>
      </div>
      <div class="stack gap-2">
        <span class="eyebrow">Reach me</span>
        <a class="link" href="mailto:armandcollier24@gmail.com">armandcollier24@gmail.com <span class="arrow">↗</span></a>
        <a class="link" href="https://github.com/armandParser">github.com/armandParser <span class="arrow">↗</span></a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
