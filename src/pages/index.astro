---
// src/pages/card.astro
const cols = 15;
const rows = 7;
const dotSizes: string[] = [];
for (let row = 0; row < rows; row++) {
  for (let col = 0; col < cols; col++) {
    const size = (1.5 + (col / (cols - 1)) * 4.5).toFixed(2);
    dotSizes.push(size);
  }
}

const projects = [
  {
    title: 'Tenders',
    descriptionFr: "Client convivial pour le portail des marchés publics français.",
    meta: 'Web · Open source',
    href: 'https://tendersansfrites.netlify.app',
    github: 'https://github.com/armandParser/tenders',
    video: '/previews/tenders.mp4',
  },
  {
    title: 'tldfetch',
    descriptionFr: "Outil de test d'API sur canvas — flux de requêtes visuels avec blocs et flèches.",
    meta: 'Web · DevTools',
    href: 'https://tldfetch.netlify.app',
    github: 'https://github.com/armandParser/tldfetch',
    video: '/previews/tldfetch.mp4',
  },
  {
    title: 'drams-react',
    descriptionFr: 'Bibliothèque React de contrôles UI 3D/néomorphiques — inspirés de Dieter Rams.',
    meta: 'Library · React',
    href: 'https://drams-react.netlify.app',
    github: 'https://github.com/armandParser/drams-react',
    video: '/previews/drams-react.mp4',
  },
  {
    title: 'Kimi Antonelli',
    descriptionFr: "Site personnel du pilote F1 Kimi Antonelli.",
    meta: 'Site · Personnel',
    href: 'https://kimiantonelli.netlify.app',
    video: '/previews/kimi-antonelli.mp4',
  },
  {
    title: 'Maggie Editor',
    descriptionFr: "Interface de création de magazines et journaux.",
    meta: 'Web · DevTools',
    href: 'https://maggie-editor.netlify.app/',
    github: 'https://github.com/armandParser/maggie',
    video: '/previews/maggie.mp4',
  },
  {
    title: 'Parser Lab',
    descriptionFr: 'Site de studio logiciel.',
    meta: 'Site · Studio',
    href: 'https://parser-lab.com',
    video: '/previews/parser-lab.mp4',
  },
  {
    title: 'Oyo Escapes',
    descriptionFr: "Site d'expériences de voyage.",
    meta: 'Site · Travel',
    video: '/previews/oyo-escapes.mp4',
  },
  {
    title: 'La Gragna Guette',
    descriptionFr: 'Restaurant toulousain.',
    meta: 'Site · Restaurant',
    href: 'https://lagragnaguette.com',
    video: '/previews/la-gragna-guette.mp4',
  },
  {
    title: 'Liftov Bordeaux',
    descriptionFr: 'Bar bordelais.',
    meta: 'Site · Fitness',
    href: 'https://liftovbordeaux.fr',
    video: '/previews/liftov-bordeaux.mp4',
  },
  {
    title: 'Bauer Débarras',
    descriptionFr: "Site de débarras et enlèvement de déchets.",
    meta: 'Site · Services',
    href: 'https://bauer-debarras.netlify.app',
    video: '/previews/bauer-debarras.mp4',
  },
] as const;
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Armand Collier — Développeur web</title>
  <style is:global>
    @font-face {
      font-family: 'NeueMontreal';
      src: url('/fonts/NeueMontreal-Regular.otf') format('opentype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'NeueMontreal';
      src: url('/fonts/NeueMontreal-Bold.otf') format('opentype');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
    body {
      font-family: 'NeueMontreal', Helvetica, Arial, system-ui, sans-serif;
      background: #fff;
      color: #111;
      overflow-x: hidden;
    }

    /* ================================================================
       ANIMATIONS
    ================================================================ */

    @keyframes s1-slide-up {
      from { transform: translateY(110%); }
      to   { transform: translateY(0); }
    }

    @keyframes s1-image-in {
      from { transform: translateX(100%); }
      to   { transform: translateX(0); }
    }

    @keyframes s1-desc-in {
      from { opacity: 0; transform: translateY(0.5rem); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .s1__line-body, .s1__image, .s1__desc { animation: none; }
    }

    /* ================================================================
       SECTION 1
    ================================================================ */

    .s1 {
      min-height: 100dvh;
      padding: clamp(2rem, 4vw, 4rem);
      padding-bottom: 0;
      display: flex;
      flex-direction: column;
    }

    .s1__title {
      font-family: 'NeueMontreal', Helvetica, Arial, system-ui, sans-serif;
      font-weight: 400;
      font-size: clamp(5.5rem, 14vw, 16rem);
      line-height: 0.87;
      letter-spacing: -0.035em;
      color: #000000;
      margin-bottom: clamp(1rem, 3vh, 3.5rem);
      flex-shrink: 0;
    }

    .s1__line-clip {
      display: block;
      overflow: hidden;
      padding-bottom: 0.06em;
    }

    .s1__line-body {
      display: block;
      animation: s1-slide-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .s1__line-body--2 { animation-delay: 0.1s; }

    .s1__lower {
      flex: 1;
      position: relative;
      min-height: 70vh;
    }

    .s1__image-wrap {
      position: absolute;
      left: 0; right: 0;
      top: 28%;
      bottom: 0;
      overflow: hidden;
    }

    .s1__image {
      position: absolute;
      inset: 0;
      animation: s1-image-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
      overflow: hidden;
    }

    .s1__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      display: block;
    }

    .s1__desc {
      font-size: clamp(1rem, 2vw, 1.5rem);
      font-weight: 400;
      line-height: 1.65;
      color: #555;
      max-width: 44ch;
      margin-bottom: clamp(1rem, 2vh, 2rem);
      flex-shrink: 0;
      animation: s1-desc-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.9s both;
    }

    .s1-scroll-space {
      height: 100dvh;
      background: #fff;
      transition: background-color 0.5s ease;
    }

    body.contact-active .s1-scroll-space {
      background: transparent;
    }

    /* ================================================================
       PROJECTS OVERLAY
    ================================================================ */

    .proj-overlay {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 50vh;
      z-index: 10;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: flex-end;
      padding: 0 0 clamp(1.5rem, 3vh, 3rem);
      background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.45) 0%,
        rgba(0,0,0,0.2) 65%,
        transparent 100%
      );
    }

    .proj-overlay.is-active {
      opacity: 1;
      pointer-events: all;
    }

    .proj-list {
      display: flex;
      gap: clamp(2rem, 4vw, 3.5rem);
      list-style: none;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-left: 50vw;
      padding-right: calc(50vw - 105px); /* last card centers at 50vw */
      width: 100%;
      padding-bottom: 2px;
      touch-action: pan-x;
    }

    .proj-list::-webkit-scrollbar { display: none; }

    .proj-card {
      flex-shrink: 0;
      width: 210px;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .proj-video {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      border-radius: 2px;
      margin-bottom: 0.6rem;
    }

    .proj-meta {
      font-size: 0.58rem;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.4);
    }

    .proj-title {
      font-size: clamp(1.1rem, 1.8vw, 1.5rem);
      font-weight: 400;
      color: #fff;
      line-height: 1;
      letter-spacing: -0.025em;
    }

    .proj-desc {
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.55;
    }

    .proj-links {
      display: flex;
      gap: 0.875rem;
      margin-top: 0.3rem;
    }

    .proj-link {
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255, 255, 255, 0.4);
      text-decoration: none;
      transition: color 0.15s;
    }

    .proj-link:hover { color: #fff; }

    /* ================================================================
       CONTACT MORPH
    ================================================================ */

    .s2__tagline {
      display: grid;
    }

    .s2__tagline-inner,
    .s2__contact-title {
      grid-area: 1 / 1;
    }

    .s2__tagline-inner {
      transition: opacity 0.45s ease, transform 0.45s ease;
    }

    .s2__contact-title {
      opacity: 0;
      transform: translateY(0.6rem);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
                  transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      letter-spacing: inherit;
      color: inherit;
    }

    body.contact-active .s2__tagline-inner {
      opacity: 0;
      transform: translateY(-0.4rem);
    }

    body.contact-active .s2__contact-title {
      position: fixed;
      top: clamp(2rem, 4vw, 4rem);
      left: clamp(2rem, 4vw, 4rem);
      color: #fff;
      opacity: 1;
      transform: translateY(0);
    }

    /* ================================================================
       CONTACT CTA
    ================================================================ */

    .contact-cta {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translateX(-50%) translateY(-50%);
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      opacity: 0;
      pointer-events: none;
    }

    .contact-cta__link {
      font-size: clamp(0.9rem, 1.5vw, 1.15rem);
      color: rgba(255, 255, 255, 0.75);
      text-decoration: none;
      letter-spacing: -0.01em;
      text-align: center;
      opacity: 0;
      transform: translateY(0.75rem);
      transition: color 0.15s;
    }

    .contact-cta__link:nth-child(1) {
      transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.38s,
                  transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.38s,
                  color 0.15s;
    }

    .contact-cta__link:nth-child(2) {
      transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.52s,
                  transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.52s,
                  color 0.15s;
    }

    .contact-cta.is-active {
      opacity: 1;
      pointer-events: all;
    }

    .contact-cta.is-active .contact-cta__link {
      opacity: 1;
      transform: translateY(0);
    }

    .contact-cta__link:hover { color: #fff; }

    /* ================================================================
       SECTION 2
    ================================================================ */

    .s2 {
      min-height: 100dvh;
      padding-block: clamp(2rem, 4vw, 5rem);
      padding-inline: 0;
      display: grid;
      grid-template-columns: 46% 1fr;
      align-content: start;
      position: relative;
      background: #fff;
      z-index: 1;
      transition: background-color 0.5s ease;
    }

    body.contact-active .s2 {
      background: transparent;
    }

    .s2__dots {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: repeat(15, 1fr);
      grid-template-rows: repeat(7, 1fr);
      align-items: center;
      justify-items: center;
      pointer-events: none;
      z-index: 0;
    }

    .s2__dots span {
      border-radius: 50%;
      background: #D62B2B;
    }

    .s2__tagline {
      grid-column: 1;
      grid-row: 1;
      padding-left: clamp(2rem, 4vw, 5rem);
      padding-right: 1rem;
      font-size: clamp(1.5rem, 3vw, 2.8rem);
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: #111;
      position: relative;
      z-index: 1;
    }

    .s2__body {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      margin-top: clamp(5rem, 18vh, 14rem);
      padding-right: clamp(2rem, 4vw, 5rem);
      position: relative;
      z-index: 1;
    }

    .s2__body-p {
      font-size: clamp(0.78rem, 1.05vw, 0.9rem);
      font-weight: 400;
      line-height: 1.75;
      color: #111;
      max-width: 38ch;
    }

    /* ================================================================
       RESPONSIVE
    ================================================================ */

    @media (max-width: 720px) {
      /* Wider cards, tighter gap, recompute last-card centering padding */
      .proj-card { width: 62vw; }
      .proj-list {
        gap: 1.25rem;
        padding-right: calc(50vw - 31vw); /* last card (62vw) centers at 50vw */
      }

      /* s2 single-column */
      .s2 { grid-template-columns: 1fr; }
      .s2__tagline { padding-right: clamp(2rem, 4vw, 5rem); }
      .s2__body {
        grid-column: 1;
        margin-top: 2.5rem;
        padding-left: clamp(2rem, 4vw, 5rem);
      }
    }
  </style>
</head>
<body>

  <!-- ─── SECTION 1 ─── -->
  <section class="s1">
    <h1 class="s1__title">
      <span class="s1__line-clip"><span class="s1__line-body">Armand</span></span>
      <span class="s1__line-clip"><span class="s1__line-body s1__line-body--2">Collier</span></span>
    </h1>
    <p class="s1__desc">Développeur web depuis 2020, créateur d'interfaces modernes et expériences numériques sur mesure.</p>
    <div class="s1__lower">
      <div class="s1__image-wrap">
        <div class="s1__image">
          <img src="/previews/ascii-art.png" alt="" aria-hidden="true" />
        </div>
      </div>
    </div>
  </section>

  <!-- scroll space: image fully expands here before s2 enters -->
  <div class="s1-scroll-space" aria-hidden="true"></div>

  <!-- ─── PROJECTS OVERLAY ─── -->
  <div class="proj-overlay" id="proj-overlay" aria-hidden="true">
    <ul class="proj-list" id="proj-list">
      {projects.map((p) => (
        <li class="proj-card">
          <video class="proj-video" src={p.video} muted loop playsinline disablePictureInPicture></video>
          <span class="proj-meta">{p.meta}</span>
          <h3 class="proj-title">{p.title}</h3>
          <p class="proj-desc">{p.descriptionFr}</p>
          {'href' in p || 'github' in p ? (
            <div class="proj-links">
              {'href' in p && p.href && (
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="proj-link">↗ Live</a>
              )}
              {'github' in p && p.github && (
                <a href={p.github} target="_blank" rel="noopener noreferrer" class="proj-link">GitHub</a>
              )}
            </div>
          ) : null}
        </li>
      ))}
    </ul>
  </div>

  <!-- ─── SECTION 2 ─── -->
  <section class="s2">
    <p class="s2__tagline">
      <span class="s2__tagline-inner">Projets personnels ou professionnels réalisés dans les 12 derniers mois.</span>
      <span class="s2__contact-title" aria-hidden="true">Contact</span>
    </p>

    <!-- <div class="s2__dots" aria-hidden="true">
      {dotSizes.map((size) => (
        <span style={`width:${size}px;height:${size}px`}></span>
      ))}
    </div> -->

   
  </section>

  <div class="contact-cta" id="contact-cta" aria-hidden="true">
    <a href="mailto:armandcollier24@gmail.com" class="contact-cta__link">armandcollier24@gmail.com</a>
    <a href="https://github.com/armandParser" target="_blank" rel="noopener noreferrer" class="contact-cta__link">github.com/armandParser</a>
  </div>

  <script>
    (function () {
      const imageWrap  = document.querySelector('.s1__image-wrap') as HTMLElement;
      const lower      = document.querySelector('.s1__lower')      as HTMLElement;
      const overlayEl  = document.getElementById('proj-overlay')   as HTMLElement;
      const listEl     = document.getElementById('proj-list')      as HTMLElement;
      const contactCta = document.getElementById('contact-cta')    as HTMLElement;
      if (!imageWrap || !lower || !overlayEl || !listEl) return;

      function showContact() {
        document.body.classList.add('contact-active');
        if (contactCta) { contactCta.classList.add('is-active'); contactCta.removeAttribute('aria-hidden'); }
      }
      function hideContact() {
        document.body.classList.remove('contact-active');
        if (contactCta) { contactCta.classList.remove('is-active'); contactCta.setAttribute('aria-hidden', 'true'); }
      }

      const EXPANSION_PX = window.innerHeight;

      // Image expansion state
      let triggerScrollY: number | null = null;
      let naturalTop:     number | null = null;
      let naturalLeft:    number | null = null;
      let naturalRight:   number | null = null;

      // Overlay / scroll-lock state
      let overlayActive   = false;
      let overlayDismissed = false;
      let savedScrollY    = 0;

      /* ── scroll lock ── */
      function lockScroll() {
        savedScrollY = window.scrollY;
        Object.assign(document.body.style, {
          overflow: 'hidden',
          position: 'fixed',
          top: `-${savedScrollY}px`,
          width: '100%',
        });
      }

      function unlockScroll(targetY = savedScrollY) {
        Object.assign(document.body.style, {
          overflow: '', position: '', top: '', width: '',
        });
        window.scrollTo(0, targetY);
      }

      /* ── video visibility ── */
      const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.proj-video'));

      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      }, { root: listEl, threshold: 0.25 });

      videos.forEach((v) => videoObserver.observe(v));

      function pauseAllVideos() { videos.forEach((v) => v.pause()); }

      function playVisibleVideos() {
        const lRect = listEl.getBoundingClientRect();
        videos.forEach((v) => {
          const r = v.getBoundingClientRect();
          if (r.right > lRect.left && r.left < lRect.right) v.play().catch(() => {});
        });
      }

      /* ── overlay ── */
      function showOverlay() {
        listEl.scrollLeft = 0;
        overlayEl.classList.add('is-active');
        overlayEl.removeAttribute('aria-hidden');
        overlayActive = true;
        lockScroll();
        requestAnimationFrame(playVisibleVideos);
      }

      function hideOverlay(dismissed: boolean, targetY?: number) {
        overlayEl.classList.remove('is-active');
        overlayEl.setAttribute('aria-hidden', 'true');
        overlayActive = false;
        pauseAllVideos();
        if (dismissed) { overlayDismissed = true; showContact(); }
        unlockScroll(targetY);
      }

      /* ── image reset ── */
      function resetImage() {
        Object.assign(imageWrap.style, {
          position: '', top: '', bottom: '', left: '', right: '', zIndex: '',
        });
      }

      /* ── main scroll handler ── */
      function update() {
        if (overlayActive) return; // scroll locked, wheel/touch handler takes over

        const vh = window.innerHeight;
        const vw = window.innerWidth;

        if (triggerScrollY === null) {
          const rect   = imageWrap.getBoundingClientRect();
          const center = (rect.top + rect.bottom) / 2;
          // Only capture when image is scrolling into view from below — not when
          // already scrolled past (rect.bottom <= 0) or not yet at midpoint.
          if (rect.bottom <= 0 || center > vh / 2) return;
          triggerScrollY = window.scrollY;
          naturalTop   = rect.top;
          naturalLeft  = rect.left;
          naturalRight = vw - rect.right;
        }

        const extraScroll = window.scrollY - triggerScrollY!;

        if (extraScroll < 0) {
          if (overlayActive) hideOverlay(false);
          triggerScrollY = null;
          naturalTop = naturalLeft = naturalRight = null;
          overlayDismissed = false;
          hideContact();
          resetImage();
          return;
        }

        const progress = Math.min(1, extraScroll / EXPANSION_PX);

        // Reset dismissed flag as soon as image starts shrinking again
        if (progress < 0.98 && overlayDismissed) { overlayDismissed = false; hideContact(); }

        // Snap to full-screen at 99% to avoid subpixel gaps from scroll event granularity
        const t = progress >= 0.99 ? 0 : (1 - progress);

        Object.assign(imageWrap.style, {
          position: 'fixed',
          top:    Math.round(naturalTop!   * t) + 'px',
          left:   Math.round(naturalLeft!  * t) + 'px',
          right:  Math.round(naturalRight! * t) + 'px',
          bottom: '0',
          zIndex: '0',
        });

        if (progress >= 0.99 && !overlayActive && !overlayDismissed) {
          showOverlay();
        } else if (progress < 0.99 && overlayActive) {
          hideOverlay(false);
        }
      }

      /* ── wheel: redirect to horizontal list when overlay active ── */
      window.addEventListener('wheel', (e) => {
        if (!overlayActive) return;
        e.preventDefault();

        // Prefer native horizontal delta (trackpad), fall back to vertical
        const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        const maxScroll = listEl.scrollWidth - listEl.clientWidth;

        if (delta > 0 && listEl.scrollLeft >= maxScroll - 5) {
          // Last card centered + scroll forward → proceed to section 2
          hideOverlay(true);
        } else if (delta < 0 && listEl.scrollLeft <= 5) {
          // At list start + scroll up → release back into expansion zone.
          // Anchor to triggerScrollY (not savedScrollY) so overshoot can't push
          // target back above the 0.99 threshold and re-trigger immediately.
          hideOverlay(false, triggerScrollY! + Math.floor(EXPANSION_PX * 0.93));
        } else {
          listEl.scrollLeft += delta;
        }
      }, { passive: false });

      /* ── touch: swipe list on mobile ── */
      let touchStartX = 0;
      listEl.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });
      listEl.addEventListener('touchend', (e) => {
        if (!overlayActive) return;
        const dx = touchStartX - e.changedTouches[0].clientX;
        const maxScroll = listEl.scrollWidth - listEl.clientWidth;
        if (dx > 40 && listEl.scrollLeft >= maxScroll - 30) {
          hideOverlay(true);
        } else if (dx < -40 && listEl.scrollLeft <= 30) {
          hideOverlay(false, triggerScrollY! + Math.floor(EXPANSION_PX * 0.93));
        }
      }, { passive: true });

      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', () => {
        if (overlayActive) hideOverlay(false);
        triggerScrollY = null;
        naturalTop = naturalLeft = naturalRight = null;
        overlayDismissed = false;
        hideContact();
        resetImage();
      }, { passive: true });
    })();
  </script>

</body>
</html>
