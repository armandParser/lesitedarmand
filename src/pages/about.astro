---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AsciiDivider from '../components/AsciiDivider.astro';
import SunShape from '../components/SunShape.astro';
import { t } from '../i18n/translations';

const lang = 'en';
const tr = t(lang);
const a = tr.about;
---

<Layout title="About — Armand Collier" description="Software developer building SaaS apps and websites." lang={lang}>
  <Header lang={lang} />

  <main>
    <section class="hero shell">
      <span class="eyebrow">{a.eyebrow}</span>
      <h1 class="display" style="margin-top: 1rem;">
        <Fragment set:html={a.title} /><span class="caret"></span>
      </h1>
      <p class="hero__sub">{a.sub}</p>
      <div class="hero__shape">
        <SunShape size={240} />
      </div>
    </section>

    <AsciiDivider label={a.dividerProfile} />

    <section class="section shell">
      <div class="about-grid">
        <p>{a.profileLead}</p>
        <div class="body">
          <p>{a.profileBody1}</p>
          <p>{a.profileBody2}</p>
        </div>
      </div>
    </section>

    <AsciiDivider label={a.dividerExperience} pattern="◈ " />

    <section class="section shell">
      <div class="about-grid">
        <p>{a.experienceLead}</p>
        <div class="body">
          {a.experience.map(e => (
            <div class="exp-row">
              <span class="exp-role">{e.role}{e.org && <> — <strong>{e.org}</strong></>}</span>
              <span class="exp-right">
                <span class="meta">{e.detail}</span>
                <span class="exp-period">{e.period}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <AsciiDivider label={a.dividerCurrent} pattern="× " />

    <section class="section shell">
      <div class="about-grid">
        <p>{a.now}</p>
        <div class="body">
          {a.currentItems.map(item => <p>{item}</p>)}
        </div>
      </div>
    </section>

    <AsciiDivider label={a.dividerStack} pattern="◇ " />

    <section class="section shell">
      <div class="about-grid">
        <p>{a.stackLead}</p>
        <div class="body" style="display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 0.5rem 2rem; max-width: 540px;">
          <span>TypeScript</span><span class="meta">core</span>
          <span>Astro</span><span class="meta">sites</span>
          <span>React / Next</span><span class="meta">apps</span>
          <span>Node / Hono</span><span class="meta">apis</span>
          <span>Postgres</span><span class="meta">data</span>
          <span>Stripe</span><span class="meta">money</span>
          <span>Tailwind / vanilla CSS</span><span class="meta">style</span>
          <span>Vercel / Fly</span><span class="meta">infra</span>
        </div>
      </div>
    </section>

    <section class="section shell">
      <div class="about-grid">
        <p class="lang-stat-label">{a.githubStatsLabel}</p>
        <div class="body">
          <div class="lang-bar">
            {a.githubStats.map(s => (
              <span class="lang-bar__seg" style={`width:${s.pct}%`} title={`${s.lang} ${s.pct}%`}></span>
            ))}
          </div>
          <div class="lang-legend">
            {a.githubStats.map(s => (
              <span class="lang-legend__item">
                <span class="lang-legend__name">{s.lang}</span>
                <span class="meta">{s.pct}%</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="contact shell">
      <p class="contact__big">
        <a href="mailto:armand@parser-lab.com">{a.sayHi}<span class="caret"></span></a>
      </p>
      <div class="stack gap-2">
        <span class="eyebrow">{a.emailLabel}</span>
        <a class="link" href="mailto:armand@parser-lab.com">armand@parser-lab.com <span class="arrow">↗</span></a>
      </div>
      <div class="stack gap-2">
        <span class="eyebrow">{a.codeLabel}</span>
        <a class="link" href="https://github.com/armandParser">github.com/armandParser <span class="arrow">↗</span></a>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
